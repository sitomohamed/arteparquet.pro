# ══════════════════════════════════════════════════════════════════════════════
# ARTEPARQUET PRODUCTION ENVIRONMENT CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════════
#
# SECURITY INSTRUCTIONS:
# 1. Copy this file to .env.production
# 2. Generate all secrets with secure random values
# 3. NEVER commit .env.production to version control
# 4. Rotate all secrets immediately if they are ever exposed
#
# To generate secure secrets:
#   openssl rand -hex 32
# Or in Node.js:
#   require('crypto').randomBytes(32).toString('hex')
#
# ══════════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════════
# APPLICATION SETTINGS
# ═══════════════════════════════════════════════════════════════════════════════

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
APP_ENV=production
APP_DEBUG=false

# ═══════════════════════════════════════════════════════════════════════════════
# SECURITY SECRETS (GENERATE NEW VALUES FOR EACH!)
# ═══════════════════════════════════════════════════════════════════════════════

# CSRF token signing key (minimum 32 bytes / 64 hex chars)
CSRF_SECRET=GENERATE_WITH_openssl_rand_hex_32

# JWT signing key (minimum 32 bytes / 64 hex chars)
JWT_SECRET_KEY=GENERATE_WITH_openssl_rand_hex_32

# Application secret key (minimum 32 bytes / 64 hex chars)
APP_SECRET_KEY=GENERATE_WITH_openssl_rand_hex_32

# ═══════════════════════════════════════════════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════════════════════════════════════════════

# PostgreSQL credentials - USE STRONG PASSWORDS!
POSTGRES_USER=arteparquet_prod
POSTGRES_PASSWORD=GENERATE_STRONG_PASSWORD_MIN_24_CHARS
POSTGRES_DB=arteparquet

# Database URL (uses variables above)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}?sslmode=require

# ═══════════════════════════════════════════════════════════════════════════════
# CORS & URLS
# ═══════════════════════════════════════════════════════════════════════════════

CORS_ORIGINS=https://arteparquet.pro,https://www.arteparquet.pro
NEXT_PUBLIC_SITE_URL=https://arteparquet.pro
NEXT_PUBLIC_API_URL=https://api.arteparquet.pro

# ═══════════════════════════════════════════════════════════════════════════════
# EMAIL CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

# Gmail App Password (NOT your regular password)
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx
OWNER_EMAIL=info@arteparquet.pro

# ═══════════════════════════════════════════════════════════════════════════════
# PUBLIC SETTINGS (safe to expose in browser)
# ═══════════════════════════════════════════════════════════════════════════════

NEXT_PUBLIC_PHONE=+393892407827
NEXT_PUBLIC_WHATSAPP=393892407827
NEXT_PUBLIC_EMAIL=info@arteparquet.pro

# ═══════════════════════════════════════════════════════════════════════════════
# ANALYTICS & TRACKING (consent-gated)
# ═══════════════════════════════════════════════════════════════════════════════

NEXT_PUBLIC_GA_ID=G-CXJX669QNK

# Meta Pixel — must be NEXT_PUBLIC_ so Next.js bakes it into the browser bundle
NEXT_PUBLIC_META_PIXEL_ID=1083893604335183

# Meta/Facebook Pixel (server-side via Conversions API)
META_PIXEL_ID=1083893604335183
META_CAPI_ACCESS_TOKEN=YOUR_META_CONVERSIONS_API_TOKEN
# META_CAPI_TEST_EVENT_CODE=TEST12345  # Uncomment for testing

# ═══════════════════════════════════════════════════════════════════════════════
# SEO & INDEXING
# ═══════════════════════════════════════════════════════════════════════════════

# IndexNow API key (generate at https://www.indexnow.org/)
INDEXNOW_KEY=your-indexnow-key
# Secret for triggering bulk IndexNow updates
INDEXNOW_SECRET=GENERATE_LONG_RANDOM_SECRET

# ═══════════════════════════════════════════════════════════════════════════════
# JWT SETTINGS
# ═══════════════════════════════════════════════════════════════════════════════

JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
