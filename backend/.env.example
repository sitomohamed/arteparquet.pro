# Environment
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=generate_a_secure_secret_key_here

# Database
# For EasyPanel, the internal link provided should be modified to postgresql:// or postgresql+asyncpg:// depending on driver.
DATABASE_URL=postgresql://arteparquet:arteparquet@arteparquet_database:5432/arteparquet?sslmode=disable

# JWT Settings
JWT_SECRET_KEY=generate_a_secure_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=https://arteparquet.pro,https://www.arteparquet.pro
